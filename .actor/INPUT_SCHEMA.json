{
  "title": "Japan Luxury Brand Market Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "statsMode": {
      "title": "相場統計モード",
      "type": "boolean",
      "description": "有効にすると通常の商品プッシュではなく相場統計を1件出力します",
      "default": false
    },
    "statsKeyword": {
      "title": "相場統計フィルタキーワード",
      "type": "string",
      "description": "タイトル部分一致で絞り込み（省略可）",
      "editor": "textfield"
    },
    "searchKeyword": {
      "title": "検索キーワード（ブランド名など）",
      "type": "string",
      "description": "エルメス、ルイヴィトン、ロレックスなど。空欄だと主要カテゴリスキャン",
      "prefill": "エルメス",
      "editor": "textfield"
    },
    "maxItems": {
      "title": "最大取得件数",
      "type": "integer",
      "description": "取得する最大商品数",
      "default": 100,
      "minimum": 1
    },
    "maxPages": {
      "title": "最大ページ数",
      "type": "integer",
      "description": "各ソースで取得する最大ページ数",
      "default": 2,
      "minimum": 1
    },
    "sources": {
      "title": "取得ソース",
      "type": "string",
      "description": "カンマ区切り（komehyo,jackroad）",
      "default": "komehyo,jackroad",
      "editor": "textfield"
    },
    "proxyConfiguration": {
      "title": "Proxy設定",
      "type": "object",
      "editor": "proxy",
      "description": "Apifyプロキシ設定（自動）",
      "default": {
        "useApifyProxy": true
      }
    }
  },
  "required": []
}
